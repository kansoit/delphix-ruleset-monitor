[Unit]
Description=Delphix Continuous Compliance Ruleset Drift Monitor Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/bin/delphix-ruleset-monitor
Environment=DELPHIX_RULESET_MONITOR_DATA_DIR=/var/lib/delphix-ruleset-monitor
ExecStart=/usr/bin/env python3 /usr/local/bin/delphix-ruleset-monitor/ruleset_monitor.py --audit
StandardOutput=journal
StandardError=journal
Restart=no
# 75 = auditoría parcial (algún Ruleset no pudo auditarse); se notifica por correo sin marcar la unidad como fallida
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target
